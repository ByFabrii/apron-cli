{
  "name": "@byfabrii/apron",
  "version": "0.9.0",
  "description": "Compila, sube y comparte los builds de tus apps (APK, AAB, IPA, OTA de Expo) desde tu propio servidor Apron",
  "keywords": ["apron", "builds", "apk", "aab", "expo", "ota", "self-hosted", "cli"],
  "license": "MIT",
  "author": "Fabrizzio Carbonell",
  "homepage": "https://github.com/ByFabrii/apron-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ByFabrii/apron-cli.git"
  },
  "bugs": {
    "url": "https://github.com/ByFabrii/apron-cli/issues"
  },
  "type": "module",
  "bin": {
    "apron": "dist/apron.js"
  },
  "files": [
    "dist/apron.js",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:js": "bun build src/index.ts --target=node --outfile dist/apron.js",
    "check:pack": "bun run scripts/check-pack.ts",
    "prepublishOnly": "bun run typecheck && bun test && bun run build:js && bun run check:pack"
  },
  "devDependencies": {
    "@types/bun": "1.2.5",
    "@types/node": "22.13.0",
    "@types/qrcode": "1.5.5",
    "qrcode": "1.5.4",
    "typescript": "5.7.3"
  }
}
