{
  "name": "hangar-cli",
  "version": "0.5.1",
  "description": "CLI de Hangar: compila y sube builds de cualquier proyecto a tu panel",
  "type": "module",
  "private": true,
  "bin": {
    "hangar": "dist/hangar.js"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:js": "bun build src/index.ts --target=node --outfile dist/hangar.js",
    "build:bin": "bun run scripts/build-binaries.ts"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/bun": "1.2.5",
    "@types/node": "22.13.0",
    "@types/qrcode": "1.5.5",
    "typescript": "5.7.3"
  }
}
